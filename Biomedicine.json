        },
        {
          "key": "B",
          "en": "sports drink, coconut water or milk",
          "hant": "運動飲料、椰子水或牛奶",
          "correct": true
        },
        {
          "key": "C",
          "en": "salt tablets, coconut water or milk",
          "hant": "鹽片、椰子水或牛奶",
