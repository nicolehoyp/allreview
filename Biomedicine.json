      "number": 557,
      "question_en": "Which of the following are drug classes or drugs that treat angina?",
      "question_hant": "下列哪些藥物類別或藥物用於治療心絞痛？",
      "image": null,
      "options": [
        {
          "key": "A",
          "en": "Calcium channel blockers, Beta blockers, Nitrates, Ranolazine",
          "hant": "鈣離子通道阻斷劑、乙型阻斷劑、硝酸鹽類、雷諾拉嗪（Ranolazine）",
          "correct": true
        },
        {
          "key": "B",
          "en": "Calcium channel blockers, Beta agonists, Beta blockers, Nitrates",
          "hant": "鈣離子通道阻斷劑、乙型促效劑、乙型阻斷劑、硝酸鹽類",
          "correct": false
        },
        {
          "key": "C",
          "en": "Beta agonists, Beta blockers, Nitrates, Ranolazine",
          "hant": "乙型促效劑、乙型阻斷劑、硝酸鹽類、雷諾拉嗪",
          "correct": false
