    {
      "number": 714,
      "question_en": "Which of the following has the correct drug class for the treatment of constipation?",
      "question_hant": "下列何者為治療便秘的正確藥物類別配對？",
      "image": null,
      "options": [
        {
          "key": "A",
          "en": "Opioid antagonist: Trulance (plecanatide)",
          "hant": "類鴉片拮抗劑：Trulance（plecanatide，普卡那肽）",
          "correct": false
        },
        {
          "key": "B",
          "en": "Opioid agonist: Movantik (naloxegol)",
          "hant": "類鴉片促效劑：Movantik（naloxegol，那洛索醇）",
