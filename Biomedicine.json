          "hant": "於2週內（限期）轉診至基層醫師",
          "correct": false
        },
        {
          "key": "C",
          "en": "semi-urgent (next day) referral to primary care physician",
          "hant": "於隔日（半緊急）轉診至基層醫師",
          "correct": true
        },
        {
          "key": "D",
          "en": "call 911 for emergency transport",
          "hant": "撥打911緊急送醫",
          "correct": false
