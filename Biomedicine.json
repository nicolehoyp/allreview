        {
          "key": "A",
          "en": "all cups used for wet cupping",
          "hant": "所有用於濕拔罐的罐具",
          "correct": true
        },
        {
          "key": "B",
          "en": "all cups used for both dry or wet cupping",
          "hant": "所有用於乾拔罐或濕拔罐的罐具",
