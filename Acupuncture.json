        {
          "key": "C",
          "en": "LU-9 (tai yuan), ST-36 (zu san li) with warm needle, REN-6 (qi hai) with moxa",
          "hant": "太淵、溫鍼足三里、灸氣海",
          "correct": true
        },
        {
          "key": "D",
          "en": "BL-12 (feng men), BL-13 (fei shu), LU-7 (lie que)",
          "hant": "風門、肺俞、列缺",
          "correct": false
