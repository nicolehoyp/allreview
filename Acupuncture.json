          "hant": "督脈",
          "correct": false
        },
        {
          "key": "C",
          "en": "Penetrating Vessel (chong mai)",
          "hant": "衝脈",
          "correct": true
        },
        {
          "key": "D",
          "en": "Yang Stepping Vessel (yang qiao mai)",
          "hant": "陽蹻脈",
          "correct": false
