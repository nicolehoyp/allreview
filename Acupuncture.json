      "number": 428,
      "question_en": "When should medical records be written?",
      "question_hant": "病歷應於何時撰寫？",
      "image": null,
      "options": [
        {
          "key": "A",
          "en": "After treatment",
          "hant": "治療之後",
          "correct": false
        },
        {
          "key": "B",
          "en": "Within 48 hours",
          "hant": "48小時內",
