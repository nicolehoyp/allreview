    {
      "number": 831,
      "question_en": "What does the pathology of muscle meridians involve?",
      "question_hant": "經筋的病理涉及哪些因素？",
      "image": null,
      "options": [
        {
          "key": "A",
          "en": "external pathogenic factors, trauma, connection to organs",
          "hant": "外邪、外傷、與臟腑的聯繫",
