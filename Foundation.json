        },
        {
          "key": "B",
          "en": "Is the pain cramping?",
          "hant": "疼痛是否呈痙攣性？",
          "correct": true
        },
        {
          "key": "C",
          "en": "Is the pain burning?",
          "hant": "疼痛是否有灼熱感？",
          "correct": false
