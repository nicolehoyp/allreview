      "question_hant": "甘草會與下列何種藥物產生交互作用？",
      "image": null,
      "options": [
        {
          "key": "A",
          "en": "ciprofloxacin, levodopa, albuterol, digoxin",
          "hant": "ciprofloxacin（環丙沙星）、levodopa（左旋多巴）、albuterol（沙丁胺醇）、digoxin（毛地黃）",
          "correct": false
        },
        {
          "key": "B",
          "en": "warfarin, digoxin, estradiol, furosemide",
          "hant": "warfarin（華法林）、digoxin（毛地黃）、estradiol（雌二醇）、furosemide（呋塞米）",
          "correct": true
        },
        {
          "key": "C",
          "en": "levodopa, albuterol, digoxin",
          "hant": "levodopa（左旋多巴）、albuterol（沙丁胺醇）、digoxin（毛地黃）",
          "correct": false
