    {
      "number": 144,
      "question_en": "Methadone is used to treat which type of dependence?",
      "question_hant": "美沙冬（Methadone）用於治療哪一種成癮？",
      "image": null,
      "options": [
        {
          "key": "A",
          "en": "alcohol dependence",
          "hant": "酒精成癮",
          "correct": false
        },
