      "image": null,
      "options": [
        {
          "key": "A",
          "en": "deng xin cao (medulla junci), tong cao (medulla tetrapanacis), bai mao gen (rhizoma imperatae)",
          "hant": "燈心草、通草、白茅根",
          "correct": true
        },
        {
          "key": "B",
          "en": "fu ling (sclerotium poria cocos), tong cao (medulla tetrapanacis), bai mao gen (rhizoma imperatae)",
          "hant": "茯苓、通草、白茅根",
          "correct": false
        },
        {
          "key": "C",
