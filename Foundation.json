          "key": "B",
          "en": "Lower and Middle Burner",
          "hant": "下焦與中焦",
          "correct": false
        },
        {
          "key": "C",
          "en": "Lower, Middle, and Upper Burner",
          "hant": "下焦、中焦與上焦",
          "correct": false
        },
        {
          "key": "D",
          "en": "Lower Burner",
          "hant": "下焦",
          "correct": true
