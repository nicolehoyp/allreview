          "correct": false
        },
        {
          "key": "B",
          "en": "tonify KI-3 (taixi), reduce LU-5 (chize), tonify left ST-36 (zusanli), left ST-31 (biguan), and left ST-41 (jiexi)",
          "hant": "補太谿，瀉尺澤，補左側足三里、左側髀關、左側解谿",
          "correct": true
        },
        {
          "key": "C",
          "en": "reduce left ST-36 (zusanli), left ST-31 (biguan), and left ST-41 (jiexi), tonify SP-6 (sanyinjaio) and LU-9 (taiyuan)",
          "hant": "瀉左側足三里、左側髀關、左側解谿，補三陰交、太淵",
          "correct": false
        },
        {
          "key": "D",
          "en": "REN-4 (guanyuan), SP-6 (sanyinjaio), KI-3 (taixi), BL-13 (feishu), LU-1 (zhongfu)",
          "hant": "關元、三陰交、太谿、肺俞、中府",
