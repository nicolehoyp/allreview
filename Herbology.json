          "hant": "銀翹散",
          "correct": false
        },
        {
          "key": "B",
          "en": "li zhong wan (regulate the middle pill)",
          "hant": "理中丸",
          "correct": false
        },
        {
          "key": "C",
          "en": "xiao cheng qi tang (minor order the qi decoction)",
          "hant": "小承氣湯",
          "correct": false
        },
        {
          "key": "D",
          "en": "xiao chai hu tang (Minor BupleurumDecoction)",
          "hant": "小柴胡湯",
          "correct": true
